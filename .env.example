# brAInharbor configuration.
# Copy to .env and edit: cp .env.example .env
# Then run: scripts/preflight.sh

# Remove ":compose.gpu.yaml" to run on CPU only. Add ":compose.ollama-api.yaml"
# to reach the Ollama API from this host (needed by tests/hu/run.py).
COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Hostname users open in the browser. It must resolve to this machine.
# For a LAN-only setup, an entry in local DNS or /etc/hosts is enough.
DOMAIN=ai.home.arpa

# "internal" for LAN use (Caddy's own CA; install its root cert on clients),
# or an email address to get a public Let's Encrypt certificate.
CADDY_TLS=internal

# Signs login sessions. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me

# Where data lives on the host. Put models and webui data on separate
# ZFS datasets if you can (see docs/zfs.md, coming in session 2).
MODELS_DIR=./data/models
WEBUI_DATA_DIR=./data/webui
CADDY_DATA_DIR=./data/caddy

# Models pulled by scripts/pull-models.sh (space-separated). The script then
# builds brainharbor-hu, the default chat model, on top of gemma4:26b (see
# ollama/brainharbor-hu.Modelfile). gemma4:26b wrote the best Hungarian in
# our tests; it needs about 20 GB of VRAM and RAM together.
# Chat models must support tool calling: Open WebUI uses native function
# calling by default (gemma3 does not support it; gemma4 and qwen3 do).
CHAT_MODELS=gemma4:26b
EMBEDDING_MODEL=bge-m3

# Ollama tuning. Open WebUI alone sends ~6k tokens with a short question
# (probably tool descriptions), so 8k fills up fast. On a 12 GB GPU, 16k was
# as fast as 8k with gemma4:26b (tests/hu, 2026-10-26).
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=16384

# Host ports published by Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# Ollama API port on 127.0.0.1, only with compose.ollama-api.yaml.
# Change it if another Ollama already listens on 11434 on this host.
OLLAMA_API_PORT=11434

# Pinned, tested versions. Change only together with a test run.
OLLAMA_VERSION=0.40.9
OPEN_WEBUI_VERSION=v0.12.4
CADDY_VERSION=2.11.7
