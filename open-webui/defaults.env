# Open WebUI defaults for brAInharbor, loaded by compose.yaml.
#
# Open WebUI copies these into its database on its FIRST start only. Later
# changes go through the admin panel, or need an empty WEBUI_DATA_DIR.
# Values in single quotes are used as they are.

# Interface language for users who haven't picked one; it also makes the
# suggested prompts on the start page Hungarian. Each user can change it
# under Settings > General.
DEFAULT_LOCALE=hu-HU

# Model selected for new chats. scripts/pull-models.sh creates it from
# ollama/brainharbor-hu.Modelfile.
DEFAULT_MODELS=brainharbor-hu:latest

# Defaults for every chat model, unless the model's own settings in the
# admin panel say otherwise:
# - think: off. Thinking didn't improve the Hungarian answers but made them
#   4-5 times slower (tests/hu).
# - function_calling: legacy. In the default (native) mode Open WebUI sends
#   the descriptions of its built-in tools with every message: 6028 prompt
#   tokens for "Hello! Mennyi 1x1?" instead of 293, and 7.2 s instead of
#   0.4 s before the answer starts (RTX 5070, 2026-10-27). In legacy mode
#   Open WebUI searches the documents itself and adds what it finds to the
#   prompt. Users can switch a chat to native under Chat Controls.
# - system: the Hungarian system prompt, the same text as in the Modelfile.
#   Ollama drops the Modelfile's prompt as soon as Open WebUI sends a system
#   message of its own (attached knowledge, tools), so it's set here as well.
DEFAULT_MODEL_PARAMS='{"think": false, "function_calling": "legacy", "system": "Mindig kizárólag helyes, természetes magyar nyelven válaszolj, idegen szavak és más írásrendszerek betűi nélkül. Kivételt csak a bevett rövidítések és szakszavak jelentenek (például GDPR, e-mail). Írj rövid, egyszerű mondatokat, és kerüld a tükörfordításokat (például „meg fog történni”).\n\nCsak akkor írj levelet tárggyal, megszólítással és elköszönéssel, ha levelet vagy e-mailt kérnek tőled. Hivatalos levélben magázódj; ha a feladat tegeződést kér, tegeződj.\n\nPélda egy jó hivatalos levél stílusára:\nTárgy: Tájékoztatás rendelésének késedelméről\nTisztelt Ügyfelünk!\nSajnálattal tájékoztatjuk, hogy a(z) [rendelésszám] számú rendelésének kiszállítása késik. A csomag várhatóan [dátum] érkezik. A kellemetlenségért szíves elnézését kérjük."}'

# Background tasks (chat titles, tags, follow-up suggestions) don't get the
# defaults above. 1000 tokens is Open WebUI's own limit for them, which
# setting any parameter here would otherwise remove.
TASK_MODEL_PARAMS='{"think": false, "max_tokens": 1000}'

# Document search uses the user's question as it is. With query generation
# on, the model first rewrites it into search queries with an English
# prompt: in tests/hu/rag that lost the right document in about 5% of the
# answers, and added about 2 seconds to each.
ENABLE_RETRIEVAL_QUERY_GENERATION=false
